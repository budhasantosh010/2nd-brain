{
  "$defs": {
    "ConceptResolution": {
      "properties": {
        "action": {
          "enum": [
            "created",
            "duplicate",
            "updated",
            "review_pending",
            "rejected",
            "rolled_back",
            "related",
            "conflict"
          ],
          "title": "Action",
          "type": "string"
        },
        "canonical_id": {
          "title": "Canonical Id",
          "type": "string"
        },
        "decision_operation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Operation Id"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "incoming_id": {
          "title": "Incoming Id",
          "type": "string"
        },
        "review_operation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Operation Id"
        }
      },
      "required": [
        "incoming_id",
        "canonical_id",
        "action"
      ],
      "title": "ConceptResolution",
      "type": "object"
    }
  },
  "properties": {
